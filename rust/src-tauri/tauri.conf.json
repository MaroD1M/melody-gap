{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MelodyGap",
  "version": "2.0.1",
  "identifier": "com.marou1m.melodygap",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MelodyGap 曲库补漏",
        "width": 1120,
        "height": 800,
        "minWidth": 840,
        "minHeight": 540,
        "center": true,
        "visible": false,
        "resizable": true,
        "decorations": true,
        "create": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    },
    "appDirectoriesOverride": {
      "localData": "./webview2-data"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "MelodyGap 曲库补漏",
    "longDescription": "检测 QQ音乐 / 网易云音乐当前播放歌曲，并与 Subsonic 曲库比对，生成待补清单。",
    "publisher": "MaroD1M",
    "copyright": "Copyright © 2026 MaroD1M",
    "homepage": "https://github.com/MaroD1M/melody-gap",
    "license": "MIT",
    "category": "Music"
  }
}
